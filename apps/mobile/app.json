{
  "expo": {
    "name": "FarsiAI",
    "owner": "sorniamirs-team",
    "slug": "amir-sorni",
    "scheme": "farsiai",
    "version": "0.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FarsiAI برای انتخاب تصویر و افزودن آن به پیام به دسترسی گالری نیاز دارد.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ],
    "android": {
      "package": "ai.farsiai.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "ios": {
      "bundleIdentifier": "ai.farsiai.app",
      "buildNumber": "7",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FarsiAI برای انتخاب تصویر و افزودن آن به پیام به دسترسی گالری نیاز دارد.",
        "NSPhotoLibraryAddUsageDescription": "FarsiAI برای ذخیره تصویر ساخته‌شده به گالری نیاز به دسترسی دارد."
      }
    },
    "extra": {
      "eas": {
        "projectId": "447d278b-46a6-4f9a-821a-63e0c2b1d9ad"
      }
    }
  }
}
