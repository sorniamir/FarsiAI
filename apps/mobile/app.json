{
  "expo": {
    "name": "FarsiAi",
    "owner": "sorniamirs-team",
    "slug": "amir-sorni",
    "scheme": "farsiai",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "android": {
      "package": "ai.farsiai.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": ["READ_MEDIA_IMAGES"]
    },
    "ios": {
      "bundleIdentifier": "ai.farsiai.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "FarsiAI برای ذخیره تصویر ساخته‌شده به گالری نیاز به دسترسی دارد."
      }
    },
    "extra": {
      "eas": {
        "projectId": "447d278b-46a6-4f9a-821a-63e0c2b1d9ad"
      }
    }
  }
}
