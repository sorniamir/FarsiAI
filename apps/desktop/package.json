{
  "name": "farsiai-desktop",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "icon:materialize": "node scripts/materialize-icon.mjs",
    "dev": "npm run icon:materialize && vite",
    "build": "npm run icon:materialize && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "npm run icon:materialize && tauri icon public/app-icon.png",
    "tauri:dev": "npm run icons && tauri dev",
    "tauri:build": "npm run icons && tauri build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
