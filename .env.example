# Mobile app — safe public values only
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Desktop app — same backend/account as mobile; safe public values only
VITE_API_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Worker public configuration
ALLOWED_ORIGIN=*
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Worker secret — set with Wrangler/Cloudflare secret storage, never commit a value
SUPABASE_SECRET_KEY=

# Optional legacy fallback only; prefer SUPABASE_SECRET_KEY for new Supabase projects
SUPABASE_SERVICE_ROLE_KEY=
