# Mobile app — safe public values only
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Desktop app — use the SAME Supabase project and API as mobile
VITE_API_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Worker public configuration
ALLOWED_ORIGIN=*
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NANO_BANANA_MODEL=gemini-3.1-flash-lite-image

# Cloudflare Worker secrets — set with Wrangler/Cloudflare secret storage, never commit values
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=

# Optional legacy fallback only; prefer SUPABASE_SECRET_KEY for new Supabase projects
SUPABASE_SERVICE_ROLE_KEY=
