{
  "name": "farsiai",
  "private": true,
  "version": "0.5.1",
  "workspaces": ["apps/mobile", "apps/api", "apps/desktop"],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "api": "npm --workspace apps/api run dev",
    "desktop": "npm --workspace apps/desktop run dev",
    "desktop:tauri": "npm --workspace apps/desktop run tauri:dev",
    "desktop:build": "npm --workspace apps/desktop run tauri:build",
    "check:api": "npm --workspace apps/api run check",
    "check:mobile": "npm --workspace apps/mobile run typecheck",
    "check:desktop": "npm --workspace apps/desktop run typecheck",
    "check": "npm run check:api && npm run check:mobile && npm run check:desktop",
    "test:api": "npm --workspace apps/api test",
    "smoke": "node scripts/smoke.mjs"
  }
}
